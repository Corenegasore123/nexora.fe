# Frontend
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000

# Confidence display thresholds
NEXT_PUBLIC_CONFIDENCE_AUTO_ACCEPT=0.95
NEXT_PUBLIC_CONFIDENCE_FLAG=0.80

# Production (split-domain): set API URL to backend origin; ensure backend CORS_ORIGIN matches this app URL
# NEXT_PUBLIC_API_URL=https://api.yourdomain.com
# Backend must set CORS_ORIGIN=https://app.yourdomain.com and COOKIE_DOMAIN=.yourdomain.com
